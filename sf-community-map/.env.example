# GrowXth — SF community layer. Copy to `.env` and fill in. NEVER commit `.env`.
# Keys are read ONLY from the environment (research §12: secret manager;
# tokens never in prompts, logs or visible params). The code never hardcodes
# or logs these values.

# --- Google Programmable / Custom Search (connectors/custom_search.py) -------
# Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# and copy its "Search engine ID" (cx). Configure it to search the whole web.
GOOGLE_CSE_ID=

# API key for the Custom Search JSON API. Enable "Custom Search API" in a Google
# Cloud project, then create an API key at https://console.cloud.google.com/apis/credentials
# Free tier: 100 queries/day. This project defaults its budget to 90/day.
GOOGLE_API_KEY=

# --- Google Places API (connectors/places_enrich.py) -------------------------
# Enable "Places API" in the same (or another) Google Cloud project and create
# an API key. Keep it SEPARATE from GOOGLE_API_KEY so you can scope/limit each.
GOOGLE_PLACES_KEY=

# --- Optional tuning (safe defaults exist in code) ---------------------------
# CUSTOM_SEARCH_DAILY_BUDGET=90    # max CSE queries per run/day (free-tier guard)
# PLACES_DAILY_BUDGET=1000         # max Places calls per run
