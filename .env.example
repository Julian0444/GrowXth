# Public URL used in Linq messages and as the Terac task URL.
APP_URL=http://localhost:3000

# Linq Partner API. The sender number is auto-discovered when omitted.
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=

# Terac external v2 API. TERAC_PROJECT_ID is optional; GrowXth can create/reuse a project.
TERAC_API_KEY=
TERAC_PROJECT_ID=
# Optional: reconnect an already-launched Terac study to its campaign after a server restart.
TERAC_CAMPAIGN_ID=
TERAC_OPPORTUNITY_ID=

# Used only by scripts/enrich_exa.py, never by a browser bundle.
EXA_API_KEY=

# Server-only collector for worldwide Google Trends, GitHub, and X signals.
APIFY_TOKEN=
